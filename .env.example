# Wallet to watch (defaults to Tanner's trading wallet)
WATCH_ADDRESS=0xBA397fAae1D5Fe10C0356f2e585bef34577ab111

# RPC endpoints. Point Base at your Coinbase developer RPC (your
# primary) — the public fallback works but is slow for log queries.
BASE_RPC=https://developer-access-mainnet.base.org
# MONAD_RPC=            # set this to enable Monad watching

# BushidoVirtueRegistry address (Base). Optional: without it the queue
# carries scored trades only; with it, each swap also gets ready-to-sign
# recordTrade calldata for the Safe.
# BUSHIDO_REGISTRY=

# Poll interval in milliseconds (default 15000)
POLL_MS=15000

# Optional: POST every detected record as JSON to this URL.
# NOTIFY_WEBHOOK=
